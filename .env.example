# MM Recruitment Ltd - environment variable template.
# Real values are configured in Cloudflare Pages -> Settings ->
# Environment variables, never committed here. This file holds names
# and placeholders only.
#
# This project has its OWN dedicated env vars - it must never point at
# Laurus Recruitment's, Podium's, or any other Laurus Group project's
# Supabase/Resend credentials, and none of theirs should point at this
# one either.

# Resend - used only by functions/api/send-enquiry.js to relay the
# Contact and Employer Enquiry forms by email. Nothing else in Phase 1
# sends email. If unset, the form honestly reports that delivery is
# unavailable rather than pretending to have sent anything.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=MM Recruitment Ltd <notifications@mmrecruitmentltd.co.uk>

# Where enquiry emails are delivered to - a real MM Recruitment mailbox,
# to be confirmed by the business.
MM_ENQUIRY_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------
# Phase 2 (not yet implemented - see docs/LOS-INTEGRATION-PROPOSAL.md):
# candidate/employer authentication and portal data will need their own
# dedicated Supabase project (or equivalent), entirely separate from
# Laurus Recruitment's. Do not reuse Laurus Recruitment's SUPABASE_URL/
# keys for MM Recruitment under any circumstances - see the proposal
# document for why.
# ---------------------------------------------------------------------
